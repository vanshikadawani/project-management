# Backend Server Configuration
PORT=5000
APP_URL="https://project-management-nxj6.vercel.app"
NODE_ENV="development"

# Neon PostgreSQL Database Connections
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Optional AWS S3 storage configuration for documents (falls back to local filesystem if not set)
# AWS_ACCESS_KEY_ID="your-aws-access-key-id"
# AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
# AWS_REGION="eu-west-2"
# AWS_S3_BUCKET="fern-foley-documents-vault"